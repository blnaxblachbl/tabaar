{
  "name": "tabaar-service",
  "version": "1.0.0",
  "description": "High-performance, open-source Product Information and Catalog Management service",
  "license": "MIT",
  "author": "Tito Everstov",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc && cp -r src/utils/prisma/generated dist/utils/prisma/generated && cp -r src/grpc/protos dist/grpc/protos && tsc-alias",
    "start": "NODE_ENV=production node dist/index.js",
    "types-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:generate-sql": "prisma generate --sql",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:reset": "prisma migrate reset",
    "seed": "node seed.js",
    "studio": "prisma studio",
    "deploy": "prisma migrate deploy && node seed.js && npm start",
    "proto:generate": "rm -rf ./src/grpc/generated && proto-loader-gen-types --outDir=./src/grpc/generated ./src/grpc/protos/*.proto"
  },
  "imports": {
    "#*": "./src/*"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.3",
    "tsc-alias": "^1.9.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express5": "^1.1.2",
    "@elastic/elasticsearch": "^9.5.1",
    "@graphql-tools/merge": "^9.2.4",
    "@graphql-tools/schema": "^10.1.1",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "^0.8.1",
    "@grpc/reflection": "^1.0.4",
    "@paralleldrive/cuid2": "^3.3.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "deepmerge": "^4.3.1",
    "dotenv": "^18.0.4",
    "dotenv-expand": "^1000.0.0",
    "express": "^5.2.1",
    "graphql": "^16.14.2",
    "graphql-middleware": "^6.1.35",
    "graphql-parse-resolve-info": "^4.14.1",
    "graphql-shield": "^7.6.5",
    "graphql-tag": "^2.12.7",
    "graphql-tools": "^9.0.35",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.5",
    "multer": "^2.5.0",
    "node-cache": "^5.1.2",
    "nodemailer": "^10.4.0",
    "prisma": "^7.10.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  }
}
